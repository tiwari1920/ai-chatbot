# Copy this file to .env and fill in your own values.

# --- Database ---
# Leave unset to use local SQLite (./chatbot.db) — zero setup, great for dev.
# Set to a PostgreSQL URL for production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_db
DATABASE_URL=

# --- AI provider ---
# Get a key from your AI provider's console. Defaults are wired for
# Anthropic's Messages API; point AI_API_URL/AI_MODEL elsewhere for a
# different compatible provider.
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=1024

# --- Server ---
HOST=0.0.0.0
FASTAPI_PORT=8000
FLASK_PORT=5000
CORS_ORIGINS=*
